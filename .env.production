# 🎭 MuseTalk Production Environment Configuration
# Production server deployment configuration for ai-icon.rastar.dev

# ===============================================
# 🌍 Environment Type
# ===============================================
ENVIRONMENT=production

# ===============================================
# 🔧 MuseTalk API Configuration - Production
# ===============================================
# Real API (GPU-based)
MUSETALK_REAL_PORT=7860
MUSETALK_REAL_HOST=0.0.0.0
GRADIO_SERVER_NAME=0.0.0.0

# Mock API (Lightweight)
MUSETALK_MOCK_PORT=8001
MUSETALK_MOCK_HOST=0.0.0.0
MOCK_BASE_URL=https://ai-icon.rastar.dev/mock

# ===============================================
# 🌐 Production Server Configuration
# ===============================================
SERVER_DOMAIN=ai-icon.rastar.dev
PUBLIC_URL=https://ai-icon.rastar.dev
MOCK_PUBLIC_URL=https://ai-icon.rastar.dev/mock

# === GPU Configuration ===
# Which GPU devices to use (0,1,2,3 or all)
CUDA_VISIBLE_DEVICES=0
# Number of GPUs to allocate
GPU_COUNT=1
# CUDA architecture list for compilation
TORCH_CUDA_ARCH_LIST=6.0;6.1;7.0;7.5;8.0;8.6

# === Redis Configuration ===
REDIS_PORT=6379

# === Nginx/Proxy Configuration ===
HTTP_PORT=80
HTTPS_PORT=443

# === File Server Configuration ===
FILE_SERVER_PORT=8080

# === Build Configuration ===
# Docker build target (builder or runtime)
MUSETALK_BUILD_TARGET=runtime

# === External Project Integration ===
# Integration with Humaan backend
HUMAAN_BACKEND_URL=https://api-icon.rastar.dev
HUMAAN_FRONTEND_URL=https://icon.rastar.dev

# === Production Settings ===
COMPOSE_PROFILES=prod,cache
LOG_LEVEL=info
DEBUG_MODE=false

# === Security Configuration ===
ALLOWED_ORIGINS=["https://icon.rastar.dev","https://api-icon.rastar.dev","https://ai-icon.rastar.dev"]
CORS_ALLOW_CREDENTIALS=true
# 🚀 MuseTalk Mock API - Lightweight Docker Container
FROM python:3.10-slim-bullseye

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /app

# Copy only mock API requirements
COPY api/requirements.txt /app/requirements.txt

# Install Python dependencies (only what's needed for mock API)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    python-multipart==0.0.6 \
    pydantic==2.5.0 \
    python-json-logger==2.0.7

# Copy mock API code
COPY api/mock_api.py /app/mock_api.py

# Create necessary directories
RUN mkdir -p /app/temp /app/test_assets /app/data/api_storage

# Create some test files for mock responses
RUN echo '{}' > /app/data/api_storage/avatars.json && \
    echo '{}' > /app/data/api_storage/tasks.json

# Create a simple test video file (placeholder)
RUN mkdir -p /app/test_assets/avatars && \
    touch /app/test_assets/avatars/dummy_video.mp4

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Start command
CMD ["python", "-m", "uvicorn", "mock_api:app", "--host", "0.0.0.0", "--port", "8001"]
# 🎭 MuseTalk Environment Configuration Example
# Copy this file to .env and modify as needed

# ===============================================
# 🔧 MuseTalk API Configuration
# ===============================================
# Real API (GPU-based)
MUSETALK_REAL_PORT=7860
MUSETALK_REAL_HOST=0.0.0.0
GRADIO_SERVER_NAME=0.0.0.0

# Mock API (Lightweight for testing)
MUSETALK_MOCK_PORT=8001
MUSETALK_MOCK_HOST=0.0.0.0
MOCK_BASE_URL=http://localhost:8001

# === GPU Configuration ===
# Which GPU devices to use (0,1,2,3 or all)
CUDA_VISIBLE_DEVICES=0
# Number of GPUs to allocate
GPU_COUNT=1
# CUDA architecture list for compilation
TORCH_CUDA_ARCH_LIST=6.0;6.1;7.0;7.5;8.0;8.6

# === Redis Configuration ===
REDIS_PORT=6379

# === Nginx/Proxy Configuration ===
HTTP_PORT=80
HTTPS_PORT=443

# === File Server Configuration ===
FILE_SERVER_PORT=8080

# === Build Configuration ===
# Docker build target (builder or runtime)
MUSETALK_BUILD_TARGET=runtime

# === External Project Integration ===
# When using in external projects, set these to your needs
# MUSETALK_API_PORT=8000
# MOCK_API_PORT=8001
# COMPOSE_PROJECT_NAME=your-project-musetalk

# === Development Settings ===
# Uncomment for development mode
# COMPOSE_PROFILES=dev,mock,cache
# LOG_LEVEL=debug

# === Production Settings ===
# Uncomment for production mode
# COMPOSE_PROFILES=production,gpu,cache,files
# LOG_LEVEL=info